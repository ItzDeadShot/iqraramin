---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import FederatedSandbox from '../components/FederatedSandbox.astro';

const site = await getEntry('site', 'site');
if (!site) throw new Error('Missing "site" entry in src/content/data/site.yaml');
---

<BaseLayout title={site.data.name} description={site.data.tagline}>
	<main>
		<header class="hero">
			<h1>{site.data.name}</h1>
			<p class="tagline">{site.data.tagline}</p>
		</header>
		<FederatedSandbox />
	</main>
</BaseLayout>

<style>
	.hero {
		max-width: 68rem;
		margin: 0 auto;
		padding: var(--space-5) var(--space-3) 0;
	}

	.hero h1 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		font-weight: 700;
		margin: 0 0 var(--space-2);
	}

	.tagline {
		margin: 0;
		max-width: 40rem;
		font-size: 1.15rem;
		color: var(--color-muted);
	}
</style>
