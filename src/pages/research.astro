---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EvadeDetector from '../components/EvadeDetector.astro';
import PublicationList from '../components/home/PublicationList.astro';

const copy = await getEntry('copy', 'research');
if (!copy) throw new Error('Missing "research" entry in src/content/data/copy.yaml');
const publications = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
---

<BaseLayout title="Research | Muhammad Iqrar Amin" description="Publications and interactive research pieces from Muhammad Iqrar Amin's work on federated learning, intrusion detection, and explainable AI.">
	<main class="research-page">
		<h1>{copy.data.title}</h1>
		<p class="lead">{copy.data.lead}</p>
		<PublicationList items={publications} />
		{copy.data.paragraphs.map((p) => <p>{p}</p>)}
	</main>
	<EvadeDetector />
</BaseLayout>

<style>
	.research-page {
		max-width: var(--page-width);
		margin: 0 auto;
		padding: var(--space-5) var(--space-3) 0;
	}

	.research-page > * {
		max-width: var(--content-width);
	}

	.lead {
		font-size: 1.15rem;
	}
</style>
