---
import { getEntry } from 'astro:content';
import '../styles/global.css';
import wordmarkFont from '../content/data/wordmark-font.json';
import { THEME_INIT_SCRIPT } from '../lib/theme';
import { contentSecurityPolicy } from '../lib/csp';

export interface Props {
	title: string;
	description?: string;
	/** Keep search engines from indexing easter-egg pages. */
	noindex?: boolean;
}

const { title, description = 'Personal site of Muhammad Iqrar Amin (Q).', noindex = false } = Astro.props;

const site = await getEntry('site', 'site');
if (!site) throw new Error('Missing "site" entry in src/content/data/site.yaml');
// The wordmark font is a subset of just these letters; anything outside it
// would silently fall back to a different font, so refuse to build instead.
const covered = new Set(wordmarkFont.text);
const missing = [...new Set(site.data.wordmark)].filter((ch) => !/\s/.test(ch) && !covered.has(ch));
if (missing.length) {
	throw new Error(
		`Wordmark "${site.data.wordmark}" uses characters the subset font doesn't include (${missing.join(' ')}). ` +
			`Regenerate it: ${wordmarkFont.regenerate}`,
	);
}

const csp = await contentSecurityPolicy({ header: false });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Content-Security-Policy" content={csp} />
		<script is:inline set:html={THEME_INIT_SCRIPT}></script>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/jetbrains-mono-variable.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={wordmarkFont.file} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<title>{title}</title>
		<script is:inline src="/js/hello.js" defer></script>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/">
				<span class="wordmark-text" lang="ur" dir="rtl">{site.data.wordmark}</span>
				<span class="visually-hidden"> ({site.data.wordmarkLatin}), home</span>
			</a>
			<nav class="site-nav" aria-label="Primary">
				<a href="/">Home</a>
				<a href="/about">About</a>
				<a href="/research">Research</a>
				<a href="/blog">Blog</a>
				<a href="/coverage">Coverage</a>
				<a href="/flags">Flags</a>
				<a href="/whoami">Whoami</a>
				<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false">
					<svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
						<circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
						<path
							d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
							stroke="currentColor"
							stroke-width="1.8"
							stroke-linecap="round"></path>
					</svg>
					<svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
						<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="currentColor"></path>
					</svg>
					<span class="visually-hidden">Dark theme</span>
				</button>
			</nav>
		</header>
		<slot />
	</body>
</html>

<script>
	import { initThemeToggle } from '../lib/theme-toggle-client';

	const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	if (button) initThemeToggle(button);
</script>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		flex-wrap: wrap;
		max-width: var(--page-width);
		margin: 0 auto;
		padding: var(--space-4) var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}

	/* Nastaliq has very tall ascenders and deep descenders, so the box is
	   sized explicitly: the header's height never depends on the font's
	   metrics, and the font arriving can't shift the page. */
	.wordmark {
		display: flex;
		align-items: center;
		height: 2.75rem;
		text-decoration: none;
		color: var(--color-fg);
	}

	.wordmark-text {
		font-family: 'Iqrar Wordmark', var(--font-display);
		font-size: 1.9rem;
		line-height: 1;
	}

	.site-nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2) var(--space-4);
	}

	@media (max-width: 480px) {
		.site-nav {
			column-gap: var(--space-3);
		}
	}

	/* 24px-tall targets, so wrapped rows keep WCAG 2.2 target spacing. */
	.site-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--color-muted);
	}

	.site-nav a:hover {
		color: var(--color-accent);
	}

	.site-nav {
		align-items: center;
	}

	/* Shown only with JS (data-js is set by the inline head script, so it is
	   there from the first frame and the nav never shifts). */
	.theme-toggle {
		display: none;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		color: var(--color-muted);
		background: transparent;
		border: 1px solid var(--color-border);
		cursor: pointer;
	}

	:global(:root[data-js]) .theme-toggle {
		display: inline-flex;
	}

	.theme-toggle:hover {
		color: var(--color-accent);
		border-color: currentColor;
	}

	/* The icon shows the theme in use: moon when dark, sun when light. */
	.icon-moon,
	.theme-toggle[aria-pressed='true'] .icon-sun {
		display: none;
	}

	.theme-toggle[aria-pressed='true'] .icon-moon {
		display: block;
	}
</style>
