---
import type { TocEntry } from '../../lib/toc';

interface Props {
	toc: TocEntry[];
	/** 'aside': the sticky column on wide screens; 'inline': a collapsible box above the post on narrow ones. */
	variant: 'aside' | 'inline';
}

const { toc, variant } = Astro.props;
const labelId = `toc-label-${variant}`;
---

{
	variant === 'aside' ? (
		<nav class="toc toc--aside" aria-labelledby={labelId}>
			<p class="toc-label mono" id={labelId}>
				On this page
			</p>
			<ol class="toc-list">
				{toc.map((e) => (
					<li>
						<a href={`#${e.slug}`}>{e.text}</a>
						{e.children.length > 0 && (
							<ol class="toc-sub">
								{e.children.map((c) => (
									<li>
										<a href={`#${c.slug}`}>{c.text}</a>
									</li>
								))}
							</ol>
						)}
					</li>
				))}
			</ol>
			<p class="toc-top mono">
				{/* "#top" scrolls to the start of the document (HTML spec), header included. */}
				<a href="#top">Back to top</a>
			</p>
		</nav>
	) : (
		<nav class="toc toc--inline" aria-labelledby={labelId}>
			<details>
				<summary class="toc-label mono" id={labelId}>
					On this page
				</summary>
				<ol class="toc-list">
					{toc.map((e) => (
						<li>
							<a href={`#${e.slug}`}>{e.text}</a>
							{e.children.length > 0 && (
								<ol class="toc-sub">
									{e.children.map((c) => (
										<li>
											<a href={`#${c.slug}`}>{c.text}</a>
										</li>
									))}
								</ol>
							)}
						</li>
					))}
				</ol>
			</details>
		</nav>
	)
}

<style>
	.toc-label {
		margin: 0;
		padding-bottom: var(--space-1);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		border-bottom: 2px solid var(--color-fg);
	}

	.toc-list,
	.toc-sub {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.toc-list {
		margin-top: var(--space-2);
		font-size: 0.9rem;
		line-height: 1.35;
	}

	.toc-list > li + li {
		margin-top: var(--space-2);
	}

	.toc-sub {
		margin-top: var(--space-1);
		padding-left: var(--space-3);
		border-left: 1px solid var(--color-border);
		font-size: 0.85rem;
	}

	.toc-sub li + li {
		margin-top: var(--space-1);
	}

	.toc a {
		display: inline-block;
		padding: 2px 0;
		color: var(--color-fg);
		text-decoration: none;
	}

	.toc-sub a {
		color: var(--color-muted);
	}

	.toc a:hover {
		color: var(--color-accent);
		text-decoration: underline;
	}

	.toc-top {
		margin: var(--space-3) 0 0;
		padding-top: var(--space-2);
		border-top: 1px solid var(--color-border);
		font-size: 0.8rem;
	}

	/* Wide screens: stays in view while the post scrolls. Scrolls itself if
	   a post has more headings than fit the window. */
	.toc--aside {
		position: sticky;
		top: var(--space-4);
		max-height: calc(100vh - 2 * var(--space-4));
		overflow-y: auto;
	}

	.toc--inline details {
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		padding: var(--space-2) var(--space-3);
	}

	.toc--inline summary {
		cursor: pointer;
		border-bottom: 0;
		padding: var(--space-1) 0;
	}

	.toc--inline details[open] summary {
		border-bottom: 2px solid var(--color-fg);
	}

	.toc--inline .toc-list {
		padding-bottom: var(--space-2);
	}
</style>
